# ============================================================
# 复制成 .env 后按需修改；不建 .env 也能跑（compose 里有默认值）
# ============================================================

# ---- 对外端口 ----
BACKEND_PORT=8080
ADMIN_PORT=8082
USER_WEB_PORT=8000

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=coffee

# ---- RabbitMQ ----
RABBITMQ_USER=mzhl
RABBITMQ_PASSWORD=mzhl123456

# ---- JVM ----
JAVA_OPTS=-Xms256m -Xmx512m

# ---- AI 客服（DeepSeek）----
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ---- 阿里云 OSS（上传图片用，可留空）----
ALIOSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIOSS_ACCESS_KEY_ID=your-oss-access-key-id
ALIOSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
ALIOSS_BUCKET=your-bucket-name

# ---- 店铺 ----
SHOP_ADDRESS=麦子黄了·总店
